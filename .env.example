# 이 파일을 .env로 복사한 뒤 값을 채운다
IPDESK_MODE=sample              # sample | kipris
KIPRIS_API_KEY=                 # KIPRIS Plus에서 발급받은 키 (따옴표 없이)
KIPRIS_BASE_URL=https://plus.kipris.or.kr/kipo-api/kipi
KIPRIS_TIMEOUT_SEC=10
KIPRIS_RATE_PER_SEC=5
KIPRIS_MONTHLY_LIMIT=1000
CACHE_TTL_HOURS=24
HOST=127.0.0.1
PORT=8000
DEBUG=false
